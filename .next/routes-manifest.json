{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/content/miniseries/[id]",
      "regex": "^/api/content/miniseries/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/content/miniseries/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/content/[contentId]/miniseries-episodes",
      "regex": "^/content/([^/]+?)/miniseries\\-episodes(?:/)?$",
      "routeKeys": {
        "nxtPcontentId": "nxtPcontentId"
      },
      "namedRegex": "^/content/(?<nxtPcontentId>[^/]+?)/miniseries\\-episodes(?:/)?$"
    },
    {
      "page": "/content/[contentId]/seasons",
      "regex": "^/content/([^/]+?)/seasons(?:/)?$",
      "routeKeys": {
        "nxtPcontentId": "nxtPcontentId"
      },
      "namedRegex": "^/content/(?<nxtPcontentId>[^/]+?)/seasons(?:/)?$"
    },
    {
      "page": "/season/[seasonId]/episodes",
      "regex": "^/season/([^/]+?)/episodes(?:/)?$",
      "routeKeys": {
        "nxtPseasonId": "nxtPseasonId"
      },
      "namedRegex": "^/season/(?<nxtPseasonId>[^/]+?)/episodes(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/advert-list",
      "regex": "^/advert\\-list(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/advert\\-list(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/channel-list",
      "regex": "^/channel\\-list(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/channel\\-list(?:/)?$"
    },
    {
      "page": "/content-list",
      "regex": "^/content\\-list(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/content\\-list(?:/)?$"
    },
    {
      "page": "/products",
      "regex": "^/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/products(?:/)?$"
    },
    {
      "page": "/sign-in",
      "regex": "^/sign\\-in(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sign\\-in(?:/)?$"
    },
    {
      "page": "/sign-up",
      "regex": "^/sign\\-up(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sign\\-up(?:/)?$"
    },
    {
      "page": "/stream",
      "regex": "^/stream(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/stream(?:/)?$"
    },
    {
      "page": "/upload",
      "regex": "^/upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/upload(?:/)?$"
    },
    {
      "page": "/user",
      "regex": "^/user(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/user(?:/)?$"
    },
    {
      "page": "/user-management",
      "regex": "^/user\\-management(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/user\\-management(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}