datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Episode {
  id            String   @id @default(uuid())
  title         String
  miniseries_no Int
  content       Int
  streaming_link String  @default("")
  duration      String   @default("0")
  thumbnail     String   @default("")
  createdAt     DateTime @default(now())
}
