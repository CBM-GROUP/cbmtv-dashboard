datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Episode {
  id            String   @id @default(uuid())
  title         String
  miniseries_no Int
  content       Int
  streaming_link String  @default("")
  duration      String   @default("0")
  thumbnail     String   @default("")
  createdAt     DateTime @default(now())
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String   // In a real app, always hash this!
  role        String   @default("admin")
  phone       String?
  location    String?
  country     String?
  createdAt   DateTime @default(now())
}
