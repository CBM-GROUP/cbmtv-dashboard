# Example environment variables for cbmtv-dashboard
# Copy this file to `.env` and fill with real secrets. Do NOT commit `.env`.

# Backend API origin. MUST include the scheme (https://...) — a bare hostname
# makes axios treat it as a relative path and every API call silently 404s.
# NEXT_PUBLIC_API_URL takes precedence over NEXT_PUBLIC_API_BASE_URL if both are set.
NEXT_PUBLIC_API_BASE_URL=https://your-backend-host

NEXT_PUBLIC_MEILISEARCH_URL=
NEXT_PUBLIC_MEILISEARCH_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Used by next.config.ts to allow-list the CDN host for next/image.
# This is a public URL, not a secret.
# Video CDN host, allow-listed for next/image. Images do NOT go through it.
CLOUDFRONT_BASE_URL=https://xxxxxxxx.cloudfront.net
# S3 host images are served from, allow-listed for next/image.
NEXT_PUBLIC_S3_IMAGE_HOST=your-bucket.s3.your-region.amazonaws.com

# NOTE: S3 upload presigning lives on the Django backend, not here.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_S3_REGION_NAME /
# AWS_STORAGE_BUCKET_NAME belong in the backend's .env only. Never add them
# to this app — anything here is bundled into a client-visible deployment.

# Legacy Mux routes under src/app/api/{create-upload,upload-status,asset-details}.
# Only needed if those are still in use.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
