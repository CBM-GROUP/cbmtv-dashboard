# Example environment variables for cbmtv-dashboard
# Copy this file to `.env` and fill with real secrets. Do NOT commit `.env`.

NEXT_PUBLIC_MEILISEARCH_URL=
NEXT_PUBLIC_MEILISEARCH_API_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
CLOUDFRONT_BASE_URL=https://xxxxxxxx.cloudfront.net

# Database (for local development only - production typically uses managed DB credentials)
DATABASE_URL=postgresql://cbmtv_user:cbmtv_secure_password@db:5432/cbmtv_database?schema=public
